NODE_ENV=development
PORT=4000

# Single database holds control plane in `public` and each workspace in its own schema.
# Hosted Postgres (Neon/Supabase): use the DIRECT/session connection string (no
# `-pooler` host) — the realtime layer needs LISTEN/NOTIFY + a session search_path,
# which transaction poolers break. Prefer `sslmode=verify-full` over `require`
# (same security today, and avoids a pg deprecation warning).
#   DATABASE_URL=postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-string
BETTER_AUTH_URL=http://localhost:4000

# Frontend origins allowed to call the API with cookies. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# Optional: enables "Continue with Google" if both are set. Leave blank otherwise.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Cloudflare Turnstile CAPTCHA. When set, sign-up / sign-in /
# password-reset require a valid Turnstile token (verified server-side). Create a
# widget at https://dash.cloudflare.com → Turnstile. Set BOTH keys or NEITHER —
# the secret enforces server-side; the (public) site key is injected into the SPA
# at runtime so the widget can render. In LOCAL dev you can instead put the site
# key in echo-front/.env as VITE_TURNSTILE_SITE_KEY. Leave blank to disable.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Auth feature flags — see infrastructure/auth/auth.ts for what each enforces.
AUTH_DISABLE_SIGNUP=false              # set true for invite-only mode (sign-in still works)
AUTH_REQUIRE_EMAIL_VERIFICATION=false  # gate accounts behind a verification click (needs an email transport wired, below)
AUTH_SESSION_EXPIRES_DAYS=7            # session lifetime in days (1-365)
ADMIN_USER_IDS=                        # comma-separated user IDs that are always admins (break-glass). Normal admins are set via `bun run db:make-admin <email>`

# Email — all optional. Transport precedence: Resend, then SMTP, then neither,
# in which case emails are LOGGED instead of sent (the URL appears in stdout so
# you can complete reset / verify / invite flows during dev).
#
# 1. Resend (preferred): create a key at resend.com -> API Keys, then EITHER
#    verify your sending domain at resend.com/domains and set EMAIL_FROM to an
#    address ON that domain, OR use "Echo <onboarding@resend.dev>" — which needs
#    no DNS setup but ONLY delivers to the address that owns the Resend account.
#    Any other from-address is rejected per-send with a 403.
RESEND_API_KEY=
EMAIL_FROM=                            # e.g. "Echo <no-reply@yourdomain.com>" — default for both transports
#
# 2. SMTP fallback, used only when RESEND_API_KEY is blank. Mailtrap.io is the
#    easiest dev sandbox.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=                           # true for port 465, false for everything else
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                             # optional: from-address for SMTP only, overrides EMAIL_FROM

# S3 — all optional. If S3_BUCKET is blank, avatar uploads return 501.
# Bucket must allow public read on uploaded objects (or front it with CloudFront).
# For local dev with MinIO: set S3_ENDPOINT + S3_FORCE_PATH_STYLE=true.
AWS_REGION=
S3_BUCKET=
S3_PUBLIC_URL_BASE=                    # optional override (e.g. CloudFront URL); defaults to standard S3 URL
S3_ENDPOINT=                           # optional override for MinIO / other S3-compatible services
S3_FORCE_PATH_STYLE=false              # set true for MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AVATAR_MAX_SIZE_MB=5
