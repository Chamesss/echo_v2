{
  "name": "echo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/server.ts",
    "start": "bun run src/server.ts",
    "db:studio": "bunx drizzle-kit studio --port 8000 --verbose --config=drizzle.config.ts",
    "auth:studio": "better-auth-studio start --config src/infrastructure/auth/auth.ts --port 3002",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "bunx drizzle-kit drop",
    "db:make-admin": "bun run src/scripts/make-admin.ts",
    "db:add-member": "bun run src/scripts/add-member.ts",
    "db:migrate-tenants": "bun run src/scripts/migrate-tenants.ts",
    "db:reset-conversations": "bun run src/scripts/reset-conversations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "vitest run --config vitest.load.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@scalar/express-api-reference": "^0.4.0",
    "better-auth": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "resend": "^6.18.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "better-auth-studio": "^1.1.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
