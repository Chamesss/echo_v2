{
  "name": "echo-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "echo-server",
    "echo-front",
    "echo-mcp",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n front,server,studio -c green,blue,magenta \"bun run --filter echo-front dev\" \"bun run --filter echo-server dev\" \"bun run --filter echo-server db:studio\"",
    "dev:app": "concurrently -n front,server -c green,blue \"bun run --filter echo-front dev\" \"bun run --filter echo-server dev\"",
    "dev:server": "bun run --filter echo-server dev",
    "dev:front": "bun run --filter echo-front dev",
    "db:migrate": "bun run --filter echo-server db:migrate",
    "db:studio": "bun run --filter echo-server db:studio",
    "auth:studio": "bun run --filter echo-server auth:studio",
    "build": "bun run --filter echo-front build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "mcp": "bun run echo-mcp/src/server.ts"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  }
}
