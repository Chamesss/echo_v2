# Backend URL — fetch calls + Better Auth client point here.
VITE_API_URL=http://localhost:4000

# Optional: Cloudflare Turnstile site key (public). When set, the sign-in,
# sign-up, and forgot-password forms show a Turnstile widget and send its token
# to the API. Must pair with TURNSTILE_SECRET_KEY on the server. Leave blank to
# disable CAPTCHA. Get it at https://dash.cloudflare.com → Turnstile.
VITE_TURNSTILE_SITE_KEY=
