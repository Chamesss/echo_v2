# Hoist drizzle-orm to the top of node_modules so every consumer (our code,
# better-auth's drizzle adapter, drizzle-kit) resolves to the same instance.
# Without this, pnpm creates separate copies for each peer-dep context
# (e.g. with vs. without kysely), causing TypeScript to treat the same class
# as two distinct types and produce errors like:
#   "Type 'SQL<unknown>' is not assignable to type 'SQL<unknown>'.
#    Types have separate declarations of a private property 'shouldInlineParams'."
public-hoist-pattern[]=drizzle-orm
public-hoist-pattern[]=drizzle-orm/*
