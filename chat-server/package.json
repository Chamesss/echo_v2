{
  "name": "chat-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:studio": "drizzle-kit studio --port 8000 --verbose --config=drizzle.config.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "drizzle-kit drop",
    "db:make-admin": "tsx src/scripts/make-admin.ts",
    "db:add-member": "tsx src/scripts/add-member.ts",
    "db:migrate-tenants": "tsx src/scripts/migrate-tenants.ts",
    "db:migrate-tenants": "tsx src/scripts/migrate-tenants.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@scalar/express-api-reference": "^0.4.0",
    "better-auth": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
